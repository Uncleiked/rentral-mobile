# MongoDB/JWT staging example only; no deployment is performed by this repo setup.
# Start from .env.example for the full optional-key list and read context/environment-setup.md.
MONGODB_URL=
JWT_SECRET=
NEXT_PUBLIC_APP_URL=https://YOUR-STAGING-HOST.example
RENTRAL_STORAGE_DIR=
RENTRAL_PLATFORM_ENABLED=false
RENTRAL_SAFETY_ENABLED=false
AUTH_DEV_EMAIL_OUTBOX=false
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_ENCRYPTION_KEY=
RESEND_API_KEY=
RENTRAL_EMAIL_FROM=

# Provider gates stay off until isolated setup, current roles, test-mode provider
# acceptance, private storage/backup operation and device behavior are reviewed.
PAYMENTS_ENABLED=false
PAYSTACK_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
SETTLEMENT_ENABLED=false
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_REFUNDS_ENABLED=false
COMMERCIAL_ENABLED=false
MUX_ENABLED=false
MEDIA_WORKER_ENABLED=false
LIFECYCLE_WORKER_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
RENTRAL_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_ENABLED=false
OLUSO_ENABLED=false

# Staff privileges live in current User.staff_role, not env user-ID allowlists.
# Supabase/PostgreSQL/Didit/OPay keys are not part of the active application.

# Optional web Google OAuth; keep disabled until its additive identity setup passes.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
