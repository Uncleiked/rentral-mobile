# Copy to ignored .env.staging and enter ONLY staging/test credentials locally.
# Use `pnpm staging ...` so this file is selected explicitly.
NEXT_PUBLIC_APP_URL=https://YOUR-STAGING-HOST.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# Separate Didit Sandbox environment; same environment for all four values.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_KYC_WORKFLOW_ID=
DIDIT_KYB_WORKFLOW_ID=
# Enable only after the Didit ordering migration and signed sandbox fixtures pass.
DIDIT_ORDERING_ENABLED=false

# Leave every gate disabled until its staging migrations/checks have passed.
RENTRAL_PLATFORM_ENABLED=false
RENTRAL_SAFETY_ENABLED=false
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
# Modern webhook secret from Paystack Test mode, when active; otherwise blank.
PAYSTACK_WEBHOOK_SECRET=

# OPay adapter is not implemented. Merchant keys alone do not enable OPay.

# Dedicated Mux environment: Video token + endpoint webhook secret + signing key.
MUX_ENABLED=false
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Prefer the one-line base64-encoded PEM returned by Mux; no extra encoding.
MUX_SIGNING_PRIVATE_KEY=
MEDIA_WORKER_ENABLED=false
MEDIA_WORKER_SECRET=

# Dedicated Gemini test-project key; pick a current image/PDF + JSON-capable model.
GEMINI_API_KEY=
# Bare model id, without the models/ prefix. Deliberately no obsolete default.
GEMINI_DOCUMENT_MODEL=
GEOAPIFY_API_KEY=

# Optional email delivery; use a verified sender and dedicated test inboxes.
RESEND_API_KEY=
RENTRAL_EMAIL_FROM=
LIFECYCLE_WORKER_ENABLED=false
LIFECYCLE_WORKER_SECRET=

# First-party analytics is opt-in; use an independent random hashing secret.
RENTRAL_ANALYTICS_ENABLED=false
ANALYTICS_HASH_SECRET=
NEXT_PUBLIC_POSTHOG_ENABLED=false 
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Server-owned staging user UUID allowlists. Never a username/email or public key.
RENTRAL_ADMIN_IDS=
RENTRAL_INSIGHTS_IDS=

# Optional host-entered fee cap in NGN, a product rule rather than legal advice.
NEXT_PUBLIC_MAX_OPTIONAL_LISTING_FEE_NGN=10000000
