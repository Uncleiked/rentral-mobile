{
  "name": "rentral",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "mobile": "npm run start --workspace @rentral/mobile",
    "mobile:android": "npm run android --workspace @rentral/mobile",
    "mobile:ios": "npm run ios --workspace @rentral/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @rentral/mobile",
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:setup": "node --experimental-strip-types scripts/setup-mongodb.ts",
    "test:mongo": "node scripts/test-mongodb.mjs",
    "setup:local": "node scripts/setup-local-auth.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mux/mux-node": "15.2.0",
    "@mux/mux-player-react": "3.13.4",
    "@oluso/nextjs": "^1.0.0",
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.14.2",
    "jose": "6.2.0",
    "lucide-react": "^1.21.0",
    "mongodb": "7.8.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.404.1",
    "posthog-node": "^5.45.2",
    "radix-ui": "^1.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "pg": "^8.22.0",
    "prisma": "6.19.3",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "apps/mobile"
  ]
}
