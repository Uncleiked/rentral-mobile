// A persistent serialization point for file attachment/deletion. Tombstones
// deliberately have no TTL: an immutable object path must never be resurrected.
model StorageObject {
  id String @id @map("_id")
  bucket String
  path String
  owner_id String
  state String
  revision Int @default(0)
  digest String?
  size_bytes Int?
  content_type String?
  operation_token String?
  lease_expires_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Only actual successful upload completion sets this. Legacy adoption does not.
  upload_completed_at DateTime?

  @@unique([bucket, path])
  @@index([owner_id, state, createdAt])
  @@index([state, lease_expires_at])
}

// An immutable acknowledgement committed with its resource. Never expires:
// an uncertain client can reconcile the same command without creating twice.
model MutationReceipt {
  id String @id @map("_id")
  actor_id String
  scope String
  client_id String
  input_hash String
  resource_id String
  createdAt DateTime @default(now())
  @@unique([actor_id, scope, client_id])
  @@index([resource_id])
}

