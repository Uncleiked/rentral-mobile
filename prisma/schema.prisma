generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("MONGODB_URL")
  relationMode = "prisma"
}

model User {
  revision Int @default(0)
  id               String   @id @map("_id") @default(uuid())
  email            String   @unique
  password_hash    String?
  staff_role       String?
  suspended_at DateTime?
  suspension_reason String?
  gallery_upload_allowed Boolean? @default(false)
  gallery_permission_revision Int? @default(0)
  closed_at DateTime?
  push_consent_version Int? @default(0)
  analytics_consent Boolean? @default(false)
  analytics_consent_at DateTime?
  analytics_subjects Json?
  username         String?  @unique
  kyc_verified     Boolean  @default(false)
  account_type     String? // 'individual' or 'organization'
  verification_status String @default("unverified")
  verification_kind   String? // 'kyc' or 'kyb'
  didit_session_id    String?
  didit_workflow_id   String?
  didit_decision      Json?
  verifiedDocument String? // Stores NIN, BVN, or CAC
  bio              String?
  avatar_url       String?
  individualProfile   IndividualProfile?
  organizationProfile OrganizationProfile?
  listings         Listing[]
  savedListings    SavedListing[]
  bookingsAsSeeker Booking[] @relation("BookingSeeker")
  bookingsAsLister Booking[] @relation("BookingLister")
  conversationsAsSeeker Conversation[] @relation("ConversationSeeker")
  conversationsAsLister Conversation[] @relation("ConversationLister")
  sentMessages Message[]
  safetyNotices SafetyNotice[] @relation("SafetySubject")
  issuedSafetyNotices SafetyNotice[] @relation("SafetyIssuer")
  safetyAppeals SafetyAppeal[] @relation("SafetyAppellant")
  decidedSafetyAppeals SafetyAppeal[] @relation("SafetyDecider")
  payments PaymentIntent[]
  authoredReviews Review[] @relation("ReviewAuthor")
  receivedReviews Review[] @relation("ReviewSubject")
  disputes Dispute[]
  notifications Notification[]
  adminActions AdminAudit[]
  documentReviews DocumentReview[]
  renewals Renewal[]
  googleIdentity GoogleIdentity?
  sessions AuthSession[]
  passwordResets PasswordReset[]
  emailChanges EmailChange[]
  authEmailDeliveries AuthEmailDelivery[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Listing {
  revision Int @default(0)
  id               String  @id @map("_id") @default(uuid())
  lister_id        String
  lister           User    @relation(fields: [lister_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category         String // 'house' | 'car' | 'boat'
  // Drafts may be partial; submission/publication services validate completeness.
  text_address     String?
  base_rent_amount Float?
  asset_metadata   Json?
  video_path       String? // listings-media object path ({uid}/{mediaFolder}/video_raw.ext)
  poster_path      String? // listings-media object path (JPEG frame)
  document_path    String? // compliance-docs object path
  listing_status   String  @default("draft") // 'draft' | 'pending_verification' | 'active'
  wizard_step      String? // resume point for drafts ('capture' | 'details' | 'documents' | 'checkout')
  archived_at DateTime?
  archived_status String?
  media            MediaAsset?
  savedBy          SavedListing[]
  bookings         Booking[]
  conversations    Conversation[]
  sharedMessages   Message[]
  payments         PaymentIntent[]
  documentReview   DocumentReview?
  verification     ListingVerification?
  privateLocation  ListingLocation?
  capture_id String?
  media_source String? @default("recorded")
  gallery_media Json?
  gallery_media_paths String[] @default([])
  gallery_permission_revision Int?
  fee_waived_at DateTime?
  fee_waived_by String?
  fee_waiver_reason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([lister_id, createdAt(sort: Desc)])
  @@index([listing_status, createdAt(sort: Desc)])
}

model MediaAsset {
  revision Int @default(0)
  id              String   @id @map("_id") @default(uuid())
  listing_id      String   @unique
  listing         Listing  @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_path     String
  status          String   @default("queued")
  mux_asset_id    String?  @unique
  mux_upload_id String? @unique
  upload_bytes Int @default(0)
  upload_reconcile_page Int @default(1)
  upload_reconcile_candidates Json?
  upload_completed_at DateTime?
  upload_lease_token String?
  upload_lease_expires_at DateTime?
  playback_id     String?  @unique
  duration        Float?
  attempts        Int      @default(0)
  error_code      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  receipts        MediaWebhookReceipt[]

  @@index([status, updatedAt])
}

model MediaWebhookReceipt {
  event_id        String   @id @map("_id")
  media_id        String
  media           MediaAsset @relation(fields: [media_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime @default(now())

  @@index([media_id])
}

model IndividualProfile {
  id            String   @id @map("_id") @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  full_name     String
  date_of_birth String
  phone_number  String
  country       String
  state         String
  address       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrganizationProfile {
  id                String   @id @map("_id") @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization_name String
  phone_number      String
  country           String
  address           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WebhookLog {
  id           String   @id @map("_id") @default(uuid())
  event_id     String   @unique
  webhook_type String
  status       String?
  session_id   String?
  raw_body     String
  processed_at DateTime?
  event_created_at DateTime?
  metadata_synced_at DateTime?
  created_at   DateTime @default(now())

  @@index([session_id, event_created_at(sort: Desc)])
}

model SavedListing {
  id String @id @default(uuid()) @map("_id")
  user_id String
  listing_id String
  user User @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  @@unique([user_id, listing_id])
  @@index([listing_id])
}

model Booking {
  revision Int @default(0)
  id String @id @map("_id") @default(uuid())
  listing_id String
  seeker_id String
  lister_id String
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seeker User @relation("BookingSeeker", fields: [seeker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lister User @relation("BookingLister", fields: [lister_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind String
  status String @default("requested")
  starts_at DateTime
  ends_at DateTime
  expires_at DateTime?
  amount_kobo BigInt
  hold_credit_kobo BigInt @default(0)
  currency String @default("NGN")
  settlement_status String @default("unsettled")
  pricing_snapshot Json?
  handshake_code_hash String?
  seeker_checked_in_at DateTime?
  lister_checked_in_at DateTime?
  manual_inspection_status String?
  manual_inspection_evidence String?
  manual_inspection_requested_by String?
  manual_inspection_requested_at DateTime?
  manual_inspection_reviewed_by String?
  manual_inspection_reviewed_at DateTime?
  manual_inspection_review_reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments PaymentIntent[]
  reviews Review[]
  disputes Dispute[]
  renewals Renewal[]
  terminations LeaseTermination[]
  allocated_hold_credit HoldCreditAllocation? @relation("HoldCreditSource")
  rental_hold_credit HoldCreditAllocation? @relation("HoldCreditTarget")
  @@index([listing_id, starts_at])
  @@index([seeker_id, createdAt(sort: Desc)])
  @@index([lister_id, createdAt(sort: Desc)])
  @@index([status, expires_at])
}

model PaymentIntent {
  revision Int @default(0)
  order_id String?
  order CommercialOrder? @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id String @id @map("_id") @default(uuid())
  booking_id String?
  listing_id String?
  user_id String
  booking Booking? @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  listing Listing? @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider String @default("paystack")
  provider_environment String?
  kind String
  reference String @unique
  idempotency_key String @unique
  amount_kobo BigInt
  currency String @default("NGN")
  customer_email String
  status String @default("created")
  checkout_url String?
  provider_transaction_id String?
  paid_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events PaymentEvent[]
  ledger LedgerTransaction[]
  financialAllocations FinancialAllocation[]
  @@index([user_id, createdAt(sort: Desc)])
  @@index([booking_id])
  @@index([listing_id])
}

model PaymentEvent {
  id String @id @map("_id") @default(uuid())
  payment_id String
  payment PaymentIntent @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event_key String @unique
  event_type String
  payload_hash String
  processed_at DateTime?
  createdAt DateTime @default(now())
  @@index([payment_id])
}

model LedgerTransaction {
  id String @id @map("_id") @default(uuid())
  payment_id String
  payment PaymentIntent @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency String @default("NGN")
  kind String
  business_key String? @unique
  operation_id String?
  createdAt DateTime @default(now())
  entries LedgerEntry[]
  @@index([payment_id])
  @@index([operation_id])
}

model LedgerEntry {
  id String @id @map("_id") @default(uuid())
  transaction_id String
  transaction LedgerTransaction @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account_key String
  direction String
  amount_kobo BigInt
  currency String @default("NGN")
  createdAt DateTime @default(now())
  @@index([transaction_id])
  @@index([account_key, createdAt])
}

model Conversation {
  id String @id @map("_id") @default(uuid())
  listing_id String
  seeker_id String
  lister_id String
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seeker User @relation("ConversationSeeker", fields: [seeker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lister User @relation("ConversationLister", fields: [lister_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seeker_read_at DateTime?
  lister_read_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  @@unique([listing_id, seeker_id])
  @@index([seeker_id, updatedAt(sort: Desc)])
  @@index([lister_id, updatedAt(sort: Desc)])
}

model ConversationActivity {
  id String @id @map("_id") @default(uuid())
  conversation_id String
  user_id String
  last_seen_at DateTime
  typing_until DateTime?
  @@unique([conversation_id, user_id])
}

model PushDevice {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  user_id String
  auth_session_id String?
  installation_id String @unique
  token_hash String @unique
  proof_hash String
  platform String
  status String @default("active")
  token_ciphertext String?
  token_iv String?
  token_tag String?
  opted_in_at DateTime
  revoked_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushDelivery {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  notification_id String
  device_id String
  user_id String
  token_hash String?
  status String @default("pending")
  ticket_id String? @unique
  error_code String?
  attempts Int @default(0)
  claimed_at DateTime?
  accepted_at DateTime?
  receipt_checked_at DateTime?
  next_check_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([notification_id, device_id])
}

model CommercialOrder {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  user_id String
  client_id String
  kind String
  status String @default("created")
  currency String @default("NGN")
  amount_kobo BigInt
  price_version String
  service_days Int
  billing_environment String
  campaign_id String? @unique
  paid_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments PaymentIntent[]
  @@unique([user_id, client_id])
}

model InsightEntitlement {
  id String @id @map("_id") @default(uuid())
  user_id String
  order_id String @unique
  billing_environment String
  starts_at DateTime
  ends_at DateTime
  status String @default("active")
  createdAt DateTime @default(now())
}

model SponsoredCampaign {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  user_id String
  listing_id String
  order_id String? @unique
  billing_environment String
  status String @default("draft")
  starts_at DateTime
  ends_at DateTime
  headline String
  reviewed_by String?
  reviewed_at DateTime?
  decision_reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @map("_id") @default(uuid())
  conversation_id String
  sender_id String
  body String
  client_id String
  shared_listing_id String?
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sender User @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sharedListing Listing? @relation(fields: [shared_listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  @@unique([sender_id, client_id])
  @@index([conversation_id, createdAt, id])
  @@index([shared_listing_id])
}

model Review {
  id String @id @map("_id") @default(uuid())
  booking_id String
  author_id String
  subject_id String
  rating Int
  comment String
  booking Booking @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author User @relation("ReviewAuthor", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject User @relation("ReviewSubject", fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  @@unique([booking_id, author_id])
  @@index([subject_id, createdAt(sort: Desc)])
  @@index([author_id])
}

model Dispute {
  revision Int @default(0)
  id String @id @map("_id") @default(uuid())
  booking_id String
  opened_by String
  reason String
  status String @default("open")
  resolution String?
  resolved_by String?
  resolved_at DateTime?
  booking_resolution String?
  booking Booking @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opener User @relation(fields: [opened_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  safetyNotices SafetyNotice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([booking_id])
  @@index([opened_by])
  @@index([status, createdAt])
}

model Notification {
  id String @id @map("_id") @default(uuid())
  user_id String
  kind String
  title String
  body String
  href String?
  read_at DateTime?
  dedupe_key String? @unique
  email_status String @default("pending")
  email_claim_token String?
  email_claimed_at DateTime?
  email_attempts Int @default(0)
  provider_message_id String?
  email_delivered_at DateTime?
  email_error_code String?
  user User @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  @@index([user_id, createdAt(sort: Desc)])
}

model AdminAudit {
  id String @id @map("_id") @default(uuid())
  actor_id String?
  operator_id String?
  action String
  target_type String
  target_id String
  reason String
  metadata Json?
  actor User? @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  @@index([actor_id, createdAt(sort: Desc)])
  @@index([target_type, target_id])
}

model DocumentReview {
  id String @id @map("_id") @default(uuid())
  listing_id String @unique
  status String @default("pending")
  findings Json
  reviewed_by String?
  approved_path String?
  approved_digest String?
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer User? @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([reviewed_by])
}

model Renewal {
  revision Int @default(0)
  id String @id @map("_id") @default(uuid())
  booking_id String
  user_id String
  reference String
  recipient_route String
  status String @default("pending_review")
  original_ends_at DateTime?
  requested_ends_at DateTime?
  evidence_path String?
  host_confirmed_at DateTime?
  host_confirmed_by String?
  reviewed_by String?
  reviewed_at DateTime?
  decision_reason String?
  booking Booking @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([booking_id, reference])
  @@index([user_id, createdAt(sort: Desc)])
  @@index([status, createdAt, id])
  @@index([booking_id, status])
}

model LeaseTermination {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  booking_id String
  booking Booking @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requested_by String
  reason String
  evidence_path String?
  original_ends_at DateTime
  requested_end_at DateTime
  counterparty_decision String @default("pending")
  counterparty_decided_at DateTime?
  counterparty_reason String?
  status String @default("pending_counterparty")
  reviewed_by String?
  reviewed_at DateTime?
  decision_reason String?
  released_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([booking_id, status])
  @@index([status, requested_end_at, id])
  @@index([requested_by, createdAt(sort: Desc), id])
}

model WorkerState {
  id String @id @map("_id")
  revision Int @default(0)
  cursor Json?
  lease_token String?
  lease_expires_at DateTime?
  last_started_at DateTime?
  last_completed_at DateTime?
  last_error_code String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([lease_expires_at])
}

model WorkerFailure {
  id String @id @map("_id")
  job String
  target_type String
  target_id String
  error_code String
  attempts Int @default(0)
  status String @default("open")
  first_occurred_at DateTime @default(now())
  last_occurred_at DateTime @default(now())
  resolved_by String?
  resolved_at DateTime?
  resolution String?
  @@index([status, last_occurred_at, id])
  @@index([job, target_id])
}

model PaymentRecipient {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  user_id String
  provider String @default("paystack")
  provider_environment String
  provider_code String?
  bank_code String
  account_last4 String
  account_fingerprint String
  fingerprint_version String @default("v1")
  status String @default("pending")
  resolved_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([user_id, status, createdAt(sort: Desc)])
  @@index([provider, provider_environment, provider_code])
}

model FinancialOperation {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  provider String @default("paystack")
  provider_environment String
  kind String
  payment_id String?
  booking_id String?
  recipient_id String?
  reference String @unique
  idempotency_key String @unique
  amount_kobo BigInt
  currency String @default("NGN")
  status String @default("requested")
  retained_kobo BigInt @default(0)
  policy_version String?
  provider_id String?
  provider_status String?
  failure_code String?
  requested_by String
  participant_ids String[] @default([])
  approved_by String?
  approved_at DateTime?
  reason String
  attempted_at DateTime?
  completed_at DateTime?
  reconcile_after DateTime?
  lease_token String?
  lease_expires_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  allocations FinancialAllocation[]
  @@index([booking_id, createdAt(sort: Desc)])
  @@index([status, reconcile_after])
  @@index([participant_ids, createdAt(sort: Desc), id(sort: Desc)])
  @@index([provider, provider_environment, kind, provider_id])
}

// Immutable reservation of previously collected funds, not evidence of a transfer.
model FinancialAllocation {
  id String @id @map("_id") @default(uuid())
  operation_id String
  payment_id String
  operation FinancialOperation @relation(fields: [operation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment PaymentIntent @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount_kobo BigInt
  createdAt DateTime @default(now())
  @@unique([operation_id, payment_id])
  @@index([payment_id])
}

model ProviderReceipt {
  id String @id @map("_id") @default(uuid())
  revision Int @default(0)
  provider String @default("paystack")
  provider_environment String
  event_key String @unique
  entity_kind String
  provider_id String?
  reference String?
  payload_hash String
  hints Json?
  status String @default("pending")
  attempts Int @default(0)
  lease_token String?
  lease_expires_at DateTime?
  next_attempt_at DateTime?
  last_error_code String?
  received_at DateTime @default(now())
  processed_at DateTime?
  @@index([status, next_attempt_at])
  @@index([provider, provider_environment, reference])
}

// Consent-based, coarse telemetry. Never store raw user IDs, search text or GPS.
model MarketEvent {
  campaign_id String?
  id String @id @map("_id") @default(uuid())
  subject_hash String
  event_type String
  category String
  intent String
  neighborhood String
  budget_band String
  bedrooms Int?
  dedupe_key String @unique
  createdAt DateTime @default(now())
  @@index([createdAt, category, neighborhood])
  @@index([subject_hash, createdAt])
}

model ListingVerification {
  listing_id String @id @map("_id")
  capture_id String?
  address_hash String
  spatial_status String @default("pending")
  distance_meters Float?
  checked_at DateTime @default(now())
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SafetyNotice {
  revision Int @default(0)
  id String @id @map("_id") @default(uuid())
  subject_id String
  dispute_id String
  issued_by String
  category String
  private_reason String
  status String @default("active")
  removed_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject User @relation("SafetySubject", fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issuer User @relation("SafetyIssuer", fields: [issued_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispute Dispute @relation(fields: [dispute_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appeal SafetyAppeal?
  @@unique([dispute_id, subject_id])
  @@index([issued_by])
  @@index([subject_id, status, createdAt(sort: Desc)])
}

model SafetyAppeal {
  revision Int @default(0)
  id String @id @map("_id") @default(uuid())
  notice_id String @unique
  appellant_id String
  statement String
  status String @default("pending")
  decided_by String?
  decision_reason String?
  decided_at DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notice SafetyNotice @relation(fields: [notice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appellant User @relation("SafetyAppellant", fields: [appellant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decider User? @relation("SafetyDecider", fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([status, createdAt])
  @@index([appellant_id, createdAt(sort: Desc)])
  @@index([decided_by])
}

