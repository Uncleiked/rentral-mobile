// Private capture geometry is deliberately outside the public Listing record.
// `id` is the listing UUID; never serialize this collection to a client.
model ListingLocation {
  id String @id @map("_id")
  listing_id String @unique
  listing Listing @relation(fields: [listing_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  geometry Json
  capture_id String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Private recording evidence. Start/end readings never appear in client DTOs.
// Transitions seal the original readings; a replacement recording uses a new id.
model ListingCapture {
  id String @id @map("_id")
  revision Int @default(0)
  owner_id String
  session_id String
  begin_hash String
  finish_hash String?
  state String @default("recording")
  start_geometry Json
  start_accuracy Float
  start_sample_at DateTime
  started_at DateTime @default(now())
  finish_by DateTime
  end_geometry Json?
  end_accuracy Float?
  end_sample_at DateTime?
  finished_at DateTime?
  seal_by DateTime?
  duration_seconds Float?
  video_path String?
  video_object_id String?
  video_digest String?
  listing_id String?
  sealed_at DateTime?
  @@index([owner_id, started_at])
  @@index([listing_id])
}

