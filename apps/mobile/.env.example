# Start the backend separately with npm run dev (port 3000), then npm run mobile.
# Explicit API origins (no /api/v1); choose the address your device can reach:
# Physical Android/iPhone: http://YOUR_COMPUTER_LAN_IP:3000
# Android emulator: http://10.0.2.2:3000
# iOS simulator or web on this computer: http://localhost:3000
# A usable local Expo host may be inferred; native loopback/missing/tunnel hosts
# require this explicit setting. Expo tunnels do not expose the separate API.
# Restart Expo after editing apps/mobile/.env.local. No automatic emulator fallback.
# Never add JWT_SECRET, MONGODB_URL, database passwords or private server keys here.
EXPO_PUBLIC_API_URL=

# Optional public EAS project UUID, required only for remote device push.
# Use the same project ID on the backend. Never put EXPO_ACCESS_TOKEN here.
EXPO_PUBLIC_EAS_PROJECT_ID=
