MONGODB_URL=mongodb://127.0.0.1:27017/rentral?replicaSet=rs0&directConnection=true
# Used only if the saved URI omits its database name; default: rentral.
MONGODB_DB_NAME=rentral
# Generate privately with npm run setup:local; never put this in EXPO_PUBLIC_*.
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_DEV_EMAIL_OUTBOX=true
RENTRAL_PLATFORM_ENABLED=true
RENTRAL_SAFETY_ENABLED=true
# Optional absolute local upload location. Default: ./storage
RENTRAL_STORAGE_DIR=
# Optional host-entered fee ceiling in NGN; use the same web/server build value.
# Plain decimal 0..9999999999.99 with at most two decimals; default: 10000000.
NEXT_PUBLIC_MAX_OPTIONAL_LISTING_FEE_NGN=10000000

# Optional integrations. Keep disabled until configured and accepted.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_ENVIRONMENT=test
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_WEBHOOK_PREVIOUS_SECRET=

SETTLEMENT_ENABLED=false
SETTLEMENT_POLICY_ACK=
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_REFUNDS_ENABLED=false
PAYMENT_ACCOUNT_HASH_SECRET=
# Set 30-70-v1 only after deliberately accepting that reviewed hold policy.
SETTLEMENT_HOLD_DEFAULT_POLICY=

MUX_ENABLED=false
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MEDIA_WORKER_ENABLED=false
MEDIA_WORKER_SECRET=
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=
# Required for recording-location/address matching and listing submission; backend only.
GEOAPIFY_API_KEY=

LIFECYCLE_WORKER_ENABLED=false
LIFECYCLE_WORKER_SECRET=
RENTRAL_WORKER_API_URL=http://localhost:3000
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_ENCRYPTION_KEY=
AUTH_EMAIL_ENCRYPTION_PREVIOUS_KEY=
RESEND_API_KEY=
RENTRAL_EMAIL_FROM=
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SINCE=

PUSH_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_SINCE=
PUSH_TOKEN_ENCRYPTION_KEY=
EXPO_ACCESS_TOKEN=
# Public EAS project UUID; set the same ID in the mobile env only for push.
EXPO_PUBLIC_EAS_PROJECT_ID=

COMMERCIAL_ENABLED=false
INSIGHTS_PRICE_KOBO=
INSIGHTS_TERM_DAYS=30
SPONSORSHIP_PRICE_KOBO=
SPONSORSHIP_TERM_DAYS=7

RENTRAL_ANALYTICS_ENABLED=false
ANALYTICS_HASH_SECRET=
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
OLUSO_ENABLED=false
OLUSO_API_KEY=

# Dedicated base64url backup key. See context/backup-operations.md.
BACKUP_ENCRYPTION_KEY=
